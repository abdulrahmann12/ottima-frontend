# OTTIMA Frontend Environment Variables

# The public URL of your deployed Spring Boot Backend API.
# In production on Vercel, set this in your Vercel Dashboard -> Settings -> Environment Variables.
# IMPORTANT:
# 1. Do NOT add a trailing slash (e.g. use https://api.yourdomain.com NOT https://api.yourdomain.com/)
# 2. Must use HTTPS (HTTP will be blocked by browsers on Vercel due to mixed content security).
# 3. In local development, leave this empty to use Vite's built-in proxy (localhost:8080).

VITE_API_BASE_URL=https://your-production-backend.com
